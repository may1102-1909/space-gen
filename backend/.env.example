# Gemini AI Configuration
GEMINI_API_KEY=your_key_here
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro

# Server & CORS
CORS_ORIGINS=http://localhost:3000

# Storage & Paths (Cross-Platform)
# DATA_DIR=./data
# RECONSTRUCTION_DIR=./data/reconstruction

# Tool Paths (Optional - if binaries are not in system PATH)
# COLMAP_PATH=/usr/bin/colmap
# FFMPEG_PATH=/usr/bin/ffmpeg
# NERFSTUDIO_PATH=/opt/nerfstudio/bin
# EXTRA_TOOL_PATHS=
