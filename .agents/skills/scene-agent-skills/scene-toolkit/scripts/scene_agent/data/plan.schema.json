{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "const": "m"
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "measured",
            "assumed"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "evidence"
      ]
    },
    "storeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "elevation": {
            "type": "number"
          },
          "walls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                },
                "start": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "end": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "thickness": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "openings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                      },
                      "kind": {
                        "enum": [
                          "door",
                          "window"
                        ]
                      },
                      "offset": {
                        "type": "number",
                        "minimum": 0
                      },
                      "width": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "height": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "sill": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "offset",
                      "width",
                      "height",
                      "sill"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "start",
                "end",
                "thickness",
                "height"
              ]
            },
            "minItems": 1
          },
          "slabs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                },
                "origin": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "size": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "thickness": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "id",
                "origin",
                "size",
                "thickness"
              ]
            }
          }
        },
        "required": [
          "id",
          "elevation",
          "walls"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "name",
    "units",
    "scale",
    "storeys"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene Agent Plan 1.0 — local metres, Z-up storeys"
}
