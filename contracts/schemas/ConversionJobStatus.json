{
  "$defs": {
    "AssetRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "enum": [
            "catalog",
            "upload",
            "generated",
            "segmented"
          ],
          "title": "Source",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "format": {
          "enum": [
            "glb",
            "gltf"
          ],
          "title": "Format",
          "type": "string"
        },
        "dimensions": {
          "$ref": "#/$defs/ProposalAssetDimensions"
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "thumbnail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnail"
        },
        "productUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producturl"
        }
      },
      "required": [
        "id",
        "name",
        "source",
        "url",
        "format",
        "dimensions",
        "categories"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "ConversionStage": {
      "properties": {
        "name": {
          "enum": [
            "uploaded",
            "structure",
            "objects",
            "ready"
          ],
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "ConversionStage",
      "type": "object"
    },
    "DetectionInterpretation": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "obb": {
          "$ref": "#/$defs/OrientedBoundingBox"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "maskRegionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maskregionid"
        },
        "status": {
          "enum": [
            "auto",
            "verified",
            "corrected",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "auto",
            "user"
          ],
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "id",
        "category",
        "label",
        "obb",
        "confidence",
        "status",
        "provenance"
      ],
      "title": "DetectionInterpretation",
      "type": "object"
    },
    "FloorPlane": {
      "properties": {
        "normal": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Normal",
          "type": "array"
        },
        "constant": {
          "title": "Constant",
          "type": "number"
        },
        "provenance": {
          "enum": [
            "auto",
            "user"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "normal",
        "constant",
        "provenance"
      ],
      "title": "FloorPlane",
      "type": "object"
    },
    "ObjectPlacement": {
      "description": "World pose of a segmented object's mesh: bottom-centre position and yaw (scene frame).",
      "properties": {
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "rotationY": {
          "title": "Rotationy",
          "type": "number"
        }
      },
      "required": [
        "position",
        "rotationY"
      ],
      "title": "ObjectPlacement",
      "type": "object"
    },
    "OpeningInterpretation": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "wallId": {
          "title": "Wallid",
          "type": "string"
        },
        "kind": {
          "enum": [
            "door",
            "window",
            "opening"
          ],
          "title": "Kind",
          "type": "string"
        },
        "offset": {
          "description": "Distance along the wall from wall.start to the opening's center, in meters.",
          "minimum": 0.0,
          "title": "Offset",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0.0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0.0,
          "title": "Height",
          "type": "number"
        },
        "sill": {
          "minimum": 0.0,
          "title": "Sill",
          "type": "number"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "provenance": {
          "enum": [
            "auto",
            "user"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "verified",
                "corrected",
                "rejected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "id",
        "wallId",
        "kind",
        "offset",
        "width",
        "height",
        "sill",
        "confidence",
        "provenance"
      ],
      "title": "OpeningInterpretation",
      "type": "object"
    },
    "OrientedBoundingBox": {
      "properties": {
        "center": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "size": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Size",
          "type": "array"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "center",
        "size",
        "yaw"
      ],
      "title": "OrientedBoundingBox",
      "type": "object"
    },
    "ProposalAssetDimensions": {
      "properties": {
        "width": {
          "exclusiveMinimum": 0.0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0.0,
          "title": "Height",
          "type": "number"
        },
        "depth": {
          "exclusiveMinimum": 0.0,
          "title": "Depth",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height",
        "depth"
      ],
      "title": "ProposalAssetDimensions",
      "type": "object"
    },
    "RoomInterpretation": {
      "properties": {
        "provenance": {
          "enum": [
            "auto",
            "user"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "floor": {
          "$ref": "#/$defs/FloorPlane"
        },
        "ceilingHeight": {
          "exclusiveMinimum": 0.0,
          "title": "Ceilingheight",
          "type": "number"
        },
        "ceilingConfidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ceilingconfidence"
        },
        "outline": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Outline",
          "type": "array"
        },
        "outlineStatus": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "verified",
                "corrected",
                "rejected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outlinestatus"
        },
        "walls": {
          "items": {
            "$ref": "#/$defs/WallInterpretation"
          },
          "title": "Walls",
          "type": "array"
        },
        "openings": {
          "items": {
            "$ref": "#/$defs/OpeningInterpretation"
          },
          "title": "Openings",
          "type": "array"
        },
        "detections": {
          "items": {
            "$ref": "#/$defs/DetectionInterpretation"
          },
          "title": "Detections",
          "type": "array"
        }
      },
      "required": [
        "provenance",
        "floor",
        "ceilingHeight",
        "outline",
        "walls",
        "openings",
        "detections"
      ],
      "title": "RoomInterpretation",
      "type": "object"
    },
    "RoomStructureResult": {
      "description": "Result of the room-structure job: interpretation in the scene frame plus the suggested scan placement.",
      "properties": {
        "interpretation": {
          "$ref": "#/$defs/RoomInterpretation"
        },
        "scanToScene": {
          "maxItems": 16,
          "minItems": 16,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Scantoscene",
          "type": "array"
        },
        "gravityConfidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Gravityconfidence",
          "type": "number"
        },
        "manhattan": {
          "title": "Manhattan",
          "type": "boolean"
        },
        "diagnostics": {
          "additionalProperties": true,
          "title": "Diagnostics",
          "type": "object"
        }
      },
      "required": [
        "interpretation",
        "scanToScene",
        "gravityConfidence",
        "manhattan"
      ],
      "title": "RoomStructureResult",
      "type": "object"
    },
    "SegmentedObject": {
      "description": "One object separated from the splat by the GPU worker (ADR 002), with its own GLB.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "meshAsset": {
          "$ref": "#/$defs/AssetRef"
        },
        "placement": {
          "$ref": "#/$defs/ObjectPlacement"
        },
        "obb": {
          "$ref": "#/$defs/OrientedBoundingBox"
        },
        "maskRegionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maskregionid"
        }
      },
      "required": [
        "id",
        "label",
        "confidence",
        "meshAsset",
        "placement",
        "obb"
      ],
      "title": "SegmentedObject",
      "type": "object"
    },
    "ShellSurfaceTexture": {
      "description": "Baked floor/wall appearance in Pascal's world-planar UV frame (material.texture.url + repeat).",
      "properties": {
        "target": {
          "enum": [
            "slab",
            "wall",
            "ceiling"
          ],
          "title": "Target",
          "type": "string"
        },
        "wallId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wallid"
        },
        "textureAsset": {
          "title": "Textureasset",
          "type": "string"
        },
        "repeat": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Repeat",
          "type": "array"
        },
        "coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage",
          "type": "number"
        }
      },
      "required": [
        "target",
        "textureAsset",
        "repeat",
        "coverage"
      ],
      "title": "ShellSurfaceTexture",
      "type": "object"
    },
    "WallInterpretation": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "start": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
