      "required": [
        "id",
        "start",
        "end",
        "height",
        "thickness",
        "confidence",
        "provenance"
      ],
      "title": "WallInterpretation",
      "type": "object"
    }
  },
  "description": "Splat import -> editable room. `stage` is the furthest stage reached; `objects` runs on the GPU worker.",
  "properties": {
    "jobId": {
      "title": "Jobid",
      "type": "string"
    },
    "projectId": {
      "title": "Projectid",
      "type": "string"
    },
    "scanAssetId": {
      "title": "Scanassetid",
      "type": "string"
    },
    "pointsAssetId": {
      "title": "Pointsassetid",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "stage": {
      "enum": [
        "uploaded",
        "structure",
        "objects",
        "ready"
      ],
      "title": "Stage",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/ConversionStage"
      },
      "title": "Stages",
      "type": "array"
    },
    "progress": {
      "default": 0,
      "title": "Progress",
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoomStructureResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "objectsCount": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Objectscount"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/SegmentedObject"
      },
      "title": "Objects",
      "type": "array"
    },
    "surfaces": {
      "items": {
        "$ref": "#/$defs/ShellSurfaceTexture"
      },
      "title": "Surfaces",
      "type": "array"
    }
  },
  "required": [
    "jobId",
    "projectId",
    "scanAssetId",
    "pointsAssetId",
    "status",
    "stage",
    "stages"
  ],
  "title": "ConversionJobStatus",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
