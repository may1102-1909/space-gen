        "provenance": {
          "enum": [
            "auto",
            "user"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "verified",
                "corrected",
                "rejected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
